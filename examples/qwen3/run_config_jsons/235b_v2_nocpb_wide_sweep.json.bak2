{
  "_comment": "235B v2 non-CPB Pareto sweep, fresh_start=true. Covers cells not in the existing 39 partial dirs: aux=0.02, rlc=1.0, rlc=2.0, plus a few unique combos. Different prefix (235bv2) so cross-sweep-resume cannot accidentally pick up the existing partial dirs.",
  "_rationale": [
    "Existing dirs covered: rlc=0.5 cluster + 1 rlc=0.1; aux in {0.001, 0.005, 0.01, 0.015}.",
    "Gaps filled here: aux=0.02 non-CPB, rlc=1.0, rlc=2.0, plus kl=1.0 sweep.",
    "fresh_start=true to start from iter 0 — resume-from-checkpoint at 235B is currently a known blocker.",
    "save_interval=500 so each 4h SLURM allocation produces multiple checkpoints, in case future resume infra works."
  ],
  "sweep_name": "235b_v2_nocpb_wide",
  "env": "dsw",
  "model_size": "A22B",
  "batch_size": 1,
  "global_batch_size": 8,
  "lr": "1e-4",
  "min_lr": "1e-6",
  "seq_len": 128,
  "pad_len": 128,
  "precision": "bf16",
  "tp": 1,
  "pp": 1,
  "cp": 1,
  "etp": 1,
  "ep": 8,
  "sp": true,
  "do": true,
  "fl": true,
  "sft": false,
  "ac": "sel",
  "optimizer_offload": false,
  "save_interval": 500,
  "exit_duration_in_mins": 800,
  "train_iters": 1500,
  "eval_interval": 200,
  "eval_iters": 50,
  "dataset_path": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/qwen-datasets/mmap_qwen3_datasets_text_document",
  "valid_dataset_path": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/qwen-datasets/mmap_qwen3_datasets_text_document",
  "pretrain_checkpoint_path": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/qwen-ckpts/Qwen3-235B-A22B-to-mcore",
  "train_tokens": 1024000,
  "warmup_tokens": 10240,
  "output_basepath": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/output_router_finetuning",
  "router_only_training": true,
  "enable_wandb_logging": true,
  "fresh_start": true,
  "wandb_project_name": "qwen3-router-training",
  "wandb_run_name_base": "235bv2",
  "wandb_run_tags": ["235b", "v2-nocpb-wide", "router-only", "fresh-start"],
  "ckpt_assume_constant_structure": true,
  "ckpt_fully_parallel_save": true,
  "empty_unused_memory_level": 2,
  "rl_algorithm": "ppo",
  "rl_ppo_baseline_type": "critic",
  "rl_critic_hidden_dims": 256,
  "rl_ppo_entropy_coeff": 0.01,
  "rl_normalize_rewards": true,
  "rl_use_ema_loads": true,
  "rl_reward_topn": 2,
  "rl_discount_factor": 0,
  "rl_reward_type": "per_token_load_weighted",
  "rl_ppo_reeval": true,
  "rl_ppo_extra_lr": 0.0001,
  "rl_ppo_epochs": 1,
  "rl_lm_reward_coeff": 0,
  "moe_router_critical_path_bias": false,
  "moe_router_topology_aware": false,
  "rl_stochastic_routing": false,
  "use_rl_loss": [true, false],
  "rl_loss_coeff": [0.1, 1.0, 2.0],
  "moe_aux_loss_coeff": [0.005, 0.02],
  "kl_loss_coeff": [0, 1.0],
  "filters": [
    {
      "_comment": "RL off: KL only used inside loss_func_with_rl. Collapse KL and rlc for aux_only cells.",
      "if": {"use_rl_loss": false},
      "collapse": ["kl_loss_coeff", "rl_loss_coeff"]
    }
  ]
}
