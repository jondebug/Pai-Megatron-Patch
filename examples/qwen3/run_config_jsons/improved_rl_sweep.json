{
    "_comment": "Improved RL sweep: critical_path reward + reward normalization + combined with aux loss",
    "_rationale": [
        "Previous RL runs failed because:",
        "1. topn_load reward had compressed range (std ~0.009 on [0,1]) due to constant numerator",
        "2. No reward normalization meant advantage signal was near-zero",
        "3. RL was never combined with aux loss (which provides strong base gradients)",
        "",
        "This sweep tests:",
        "- critical_path reward (directly targets max expert load, wider dynamic range)",
        "- reward normalization (expands advantage signal to unit variance)",
        "- RL + aux loss combination (aux provides base gradient, RL adds non-differentiable correction)"
    ],
    
    "sweep_name": "improved_rl_sweep",
    
    "env": "dsw",
    "model_size": "A3B",
    "batch_size": 1,
    "global_batch_size": 8,
    "lr": "1e-4",
    "min_lr": "1e-6",
    "seq_len": 128,
    "pad_len": 128,
    "precision": "bf16",
    
    "tp": 1,
    "pp": 1,
    "cp": 1,
    "etp": 1,
    "ep": 4,
    "sp": true,
    "do": true,
    "fl": true,
    "sft": false,
    
    "ac": "sel",
    "optimizer_offload": false,
    "save_interval": 1500,
    "train_iters": 1500,
    "eval_interval": 200,
    "eval_iters": 50,
    "dataset_path": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/qwen-datasets/mmap_qwen3_datasets_text_document",
    "valid_dataset_path": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/qwen-datasets/mmap_qwen3_datasets_text_document",
    "pretrain_checkpoint_path": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/qwen-ckpts/Qwen3-30B-A3B-to-mcore",
    "train_tokens": 1024000,
    "warmup_tokens": 10240,
    "output_basepath": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/output_router_finetuning",
    
    "router_only_training": true,
    "enable_wandb_logging": true,
    "wandb_project_name": "qwen3-router-training",
    "wandb_run_name_base": "improved-rl-sweep",
    "wandb_run_tags": ["router-only", "moe-training", "improved-rl"],
    
    "_fixed_rl_params": "Fixed RL parameters for all RL runs",
    "rl_algorithm": ["ppo"],
    "rl_ppo_baseline_type": "critic",
    "rl_per_token_rewards": false,
    "rl_critic_hidden_dims": [[256]],
    "rl_ppo_entropy_coeff": [0.01],
    "rl_discount_factor": "0.9",

    "_sweep_comment": "Sweep axes: reward_type x normalize x aux_loss_coeff x rl_loss_coeff",
    
    "use_rl_loss": [true, false],
    "rl_reward_type": ["critical_path", "topn_load"],
    "rl_normalize_rewards": [true, false],
    "rl_loss_coeff": [0.5, 1.0, 2.0],
    "rl_reward_topn": [1],
    "moe_aux_loss_coeff": [0, 0.005, 0.01],

    "_filters_comment": "Filters to create meaningful combinations only",
    "filters": [
        {
            "_comment": "RL OFF baselines: only vary aux_loss_coeff, collapse all RL params",
            "if": {"use_rl_loss": false},
            "collapse": ["rl_loss_coeff", "rl_reward_type", "rl_normalize_rewards", "rl_reward_topn", "rl_algorithm", "rl_ppo_entropy_coeff", "rl_critic_hidden_dims"]
        },
        {
            "_comment": "topn_load reward doesn't need normalization comparison (we know it's broken without)",
            "if": {"rl_reward_type": "topn_load", "rl_normalize_rewards": false},
            "skip": true
        },
        {
            "_comment": "topn_load only needs topn=1 (we showed topn doesn't matter)",
            "if": {"rl_reward_type": "topn_load"},
            "collapse": ["rl_reward_topn"]
        },
        {
            "_comment": "critical_path doesn't use topn",
            "if": {"rl_reward_type": "critical_path"},
            "collapse": ["rl_reward_topn"]
        }
    ]
}
