{
  "_comment": "A/B sweep for PPO implementation changes (core comparison).",
  "_rationale": [
    "Compares legacy PPO behavior vs new implementation under matched settings.",
    "Includes k=1 control and k=5 stress in the same compact grid.",
    "Includes KL on/off to test stability-CP tradeoff under each implementation."
  ],
  "sweep_name": "ppo_impl_ab_core",
  "env": "dsw",
  "model_size": "A3B",
  "batch_size": 1,
  "global_batch_size": 8,
  "lr": "1e-4",
  "min_lr": "1e-6",
  "seq_len": 128,
  "pad_len": 128,
  "precision": "bf16",
  "tp": 1,
  "pp": 1,
  "cp": 1,
  "etp": 1,
  "ep": 4,
  "sp": true,
  "do": true,
  "fl": true,
  "sft": false,
  "ac": "sel",
  "optimizer_offload": false,
  "save_interval": 1500,
  "exit_duration_in_mins": 230,
  "train_iters": 1500,
  "eval_interval": 500,
  "eval_iters": 10,
  "dataset_path": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/qwen-datasets/mmap_qwen3_datasets_text_document",
  "valid_dataset_path": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/qwen-datasets/mmap_qwen3_datasets_text_document",
  "pretrain_checkpoint_path": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/qwen-ckpts/Qwen3-30B-A3B-to-mcore",
  "train_tokens": 1024000,
  "warmup_tokens": 10240,
  "output_basepath": "/lustre/fsw/portfolios/nvr/users/jonathanp/rl_token_routing/output_router_finetuning",
  "router_only_training": true,
  "enable_wandb_logging": true,
  "log_expert_heatmap": true,
  "fresh_start": true,
  "wandb_project_name": "qwen3-router-training",
  "wandb_run_name_base": "ppo-ab-core",
  "wandb_run_tags": ["ppo-ab", "core", "router-only"],
  "rl_algorithm": "ppo",
  "rl_ppo_baseline_type": "critic",
  "rl_critic_hidden_dims": [256],
  "rl_ppo_entropy_coeff": 0.01,
  "rl_normalize_rewards": true,
  "rl_use_ema_loads": true,
  "rl_reward_topn": 2,
  "rl_discount_factor": "0",
  "rl_reward_type": "per_token_load_weighted",
  "rl_ppo_reeval": true,
  "rl_ppo_extra_lr": 1e-4,
  "moe_router_critical_path_bias": false,
  "moe_router_topology_aware": false,
  "moe_aux_loss_coeff": 0.01,
  "rl_loss_coeff": 0.5,
  "rl_replay_buffer_size": 0,
  "rl_lm_reward_coeff": 1.0,
  "use_rl_loss": [true, false],
  "rl_ppo_legacy_mode": [true, false],
  "rl_ppo_epochs": [1, 5],
  "kl_loss_coeff": [0, 0.001],
  "filters": [
    {
      "_comment": "When RL is off, collapse RL-specific knobs to one aux-only control run.",
      "if": {"use_rl_loss": false},
      "collapse": [
        "rl_ppo_legacy_mode",
        "rl_ppo_epochs",
        "kl_loss_coeff"
      ]
    }
  ]
}
